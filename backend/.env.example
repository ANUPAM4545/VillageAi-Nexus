# Backend Environment Variables Example
PROJECT_NAME="Village AI Nexus"
API_V1_STR="/api/v1"
DATABASE_URL="postgresql+asyncpg://village_user:village_password@localhost:5432/village_db"
# Set to 'http://localhost:3000' for local dev, adjust for prod
CORS_ORIGINS=["http://localhost:3000"]

# AI Provider Configuration (e.g., openai)
AI_PROVIDER=openai
AI_API_KEY=
# Example: gpt-4o-mini
AI_MODEL=
